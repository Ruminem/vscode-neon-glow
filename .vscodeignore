.git/**
.github/**
.gitattributes
.gitignore
.vscodeignore
*.vsix

# install.cmd wraps the VSIX for the release zip; inside the VSIX it would be
# a script that installs the thing it is already inside.
install.cmd
install.sh

# tools/ regenerates icon.png, which is committed. The renderer is not needed
# at runtime.
tools/**

# install.js and uninstall.js are deliberately kept in the package: after a VS
# Code update wipes the patch, or after editing the knobs in neon-glow.js, they
# let you re-patch from the installed extension directory without a clone.

# Notes for working on this repository, not for people installing it.
CLAUDE.md
NEXT.md

# README points at these on raw.githubusercontent.com, which is what the
# Marketplace and the extension pane both fetch. Shipping them inside the VSIX
# as well would double the download for files nothing reads from there.
images/**

# The file the README clip is recorded on. It is a prop for making the picture,
# not something the extension reads, and it would arrive looking like a source
# file of ours inside someone else's installation.
samples/**

# Local agent settings. Not committed, so a CI build never sees them - but vsce
# packages the working directory, so a build made here would carry them into
# someone else's installation.
.claude/**
