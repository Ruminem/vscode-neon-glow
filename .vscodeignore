.git/**
.github/**
.gitattributes
.gitignore
.vscodeignore
*.vsix

# install.cmd wraps the VSIX for the release zip; inside the VSIX it would be
# a script that installs the thing it is already inside.
install.cmd
install.sh

# tools/ regenerates icon.png, which is committed. The renderer is not needed
# at runtime.
tools/**

# install.js and uninstall.js are deliberately kept in the package: after a VS
# Code update wipes the patch, or after editing the knobs in neon-glow.js, they
# let you re-patch from the installed extension directory without a clone.

# Notes for working on this repository, not for people installing it.
CLAUDE.md
NEXT.md
