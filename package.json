{
  "name": "vscode-neon-glow",
  "displayName": "Neon Glow",
  "description": "Neon glow for syntax highlighting, derived from whatever colour theme is active.",
  "version": "0.17.4",
  "publisher": "Ruminem",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ruminem/vscode-neon-glow.git"
  },
  "engines": {
    "vscode": "^1.73.0"
  },
  "l10n": "./l10n",
  "categories": ["Themes", "Other"],
  "keywords": ["neon", "glow", "cyberpunk", "retro", "syntax highlighting", "text-shadow"],
  "icon": "icon.png",
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "scripts": {
    "package": "node tools/package.js",
    "release": "node tools/release.js",
    "vscode:uninstall": "node ./uninstall.js"
  },
  "contributes": {
    "commands": [
      { "command": "neonGlow.toggle",  "title": "%neonGlow.toggle.title%" },
      { "command": "neonGlow.enable",  "title": "%neonGlow.enable.title%" },
      { "command": "neonGlow.disable", "title": "%neonGlow.disable.title%" },
      { "command": "neonGlow.install", "title": "%neonGlow.install.title%" },
      { "command": "neonGlow.remove",  "title": "%neonGlow.remove.title%" },
      { "command": "neonGlow.status",  "title": "%neonGlow.status.title%" },
      { "command": "neonGlow.preset",  "title": "%neonGlow.preset.title%" }
    ],
    "menus": {
      "commandPalette": [
        { "command": "neonGlow.enable",  "when": "neonGlow.off" },
        { "command": "neonGlow.disable", "when": "neonGlow.on" },
        { "command": "neonGlow.install", "when": "false" },
        { "command": "neonGlow.remove",  "when": "false" }
      ]
    },
    "configuration": {
      "title": "Neon Glow",
      "properties": {
        "neonGlow.glowLayers": {
          "type": "number",
          "default": 3,
          "enum": [3, 2, 1],
          "enumDescriptions": [
            "%neonGlow.glowLayers.enum.3%",
            "%neonGlow.glowLayers.enum.2%",
            "%neonGlow.glowLayers.enum.1%"
          ],
          "order": 0,
          "scope": "application",
          "markdownDescription": "%neonGlow.glowLayers.markdownDescription%"
        },
        "neonGlow.maxBlur": {
          "type": "number",
          "default": 36,
          "minimum": 1,
          "maximum": 64,
          "order": 1,
          "scope": "application",
          "markdownDescription": "%neonGlow.maxBlur.markdownDescription%"
        },
        "neonGlow.brightness": {
          "type": "number",
          "default": 1.0,
          "minimum": 0,
          "maximum": 3,
          "order": 2,
          "scope": "application",
          "markdownDescription": "%neonGlow.brightness.markdownDescription%"
        },
        "neonGlow.minChroma": {
          "type": "number",
          "default": 0.3,
          "minimum": 0,
          "maximum": 1,
          "order": 3,
          "scope": "application",
          "markdownDescription": "%neonGlow.minChroma.markdownDescription%"
        },
        "neonGlow.chromaSpan": {
          "type": "number",
          "default": 0.5,
          "minimum": 0.01,
          "maximum": 2,
          "order": 4,
          "scope": "application",
          "markdownDescription": "%neonGlow.chromaSpan.markdownDescription%"
        },
        "neonGlow.floor": {
          "type": "number",
          "default": 0.4,
          "minimum": 0,
          "maximum": 1,
          "order": 5,
          "scope": "application",
          "markdownDescription": "%neonGlow.floor.markdownDescription%"
        },
        "neonGlow.minLightness": {
          "type": "number",
          "default": 0.25,
          "minimum": 0,
          "maximum": 1,
          "order": 6,
          "scope": "application",
          "markdownDescription": "%neonGlow.minLightness.markdownDescription%"
        },
        "neonGlow.cursorTrail": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 400,
          "order": 7,
          "scope": "application",
          "markdownDescription": "%neonGlow.cursorTrail.markdownDescription%"
        },
        "neonGlow.saveShake": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 24,
          "order": 8,
          "scope": "application",
          "markdownDescription": "%neonGlow.saveShake.markdownDescription%"
        },
        "neonGlow.findGlow": {
          "type": "number",
          "default": 18,
          "minimum": 0,
          "maximum": 48,
          "order": 9,
          "scope": "application",
          "markdownDescription": "%neonGlow.findGlow.markdownDescription%"
        },
        "neonGlow.selectionGlow": {
          "type": "number",
          "default": 12,
          "minimum": 0,
          "maximum": 32,
          "order": 10,
          "scope": "application",
          "markdownDescription": "%neonGlow.selectionGlow.markdownDescription%"
        },
        "neonGlow.occurrenceGlow": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "maximum": 32,
          "order": 11,
          "scope": "application",
          "markdownDescription": "%neonGlow.occurrenceGlow.markdownDescription%"
        },
        "neonGlow.gutterGlow": {
          "type": "number",
          "default": 8,
          "minimum": 0,
          "maximum": 24,
          "order": 12,
          "scope": "application",
          "markdownDescription": "%neonGlow.gutterGlow.markdownDescription%"
        },
        "neonGlow.bracketMatchGlow": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "maximum": 32,
          "order": 13,
          "scope": "application",
          "markdownDescription": "%neonGlow.bracketMatchGlow.markdownDescription%"
        },
        "neonGlow.squiggleGlow": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "maximum": 16,
          "order": 14,
          "scope": "application",
          "markdownDescription": "%neonGlow.squiggleGlow.markdownDescription%"
        },
        "neonGlow.diffGlow": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "maximum": 32,
          "order": 15,
          "scope": "application",
          "markdownDescription": "%neonGlow.diffGlow.markdownDescription%"
        },
        "neonGlow.lineHighlightGlow": {
          "type": "number",
          "default": 8,
          "minimum": 0,
          "maximum": 24,
          "order": 16,
          "scope": "application",
          "markdownDescription": "%neonGlow.lineHighlightGlow.markdownDescription%"
        },
        "neonGlow.breakpointGlow": {
          "type": "number",
          "default": 8,
          "minimum": 0,
          "maximum": 24,
          "order": 17,
          "scope": "application",
          "markdownDescription": "%neonGlow.breakpointGlow.markdownDescription%"
        },
        "neonGlow.snippetGlow": {
          "type": "number",
          "default": 8,
          "minimum": 0,
          "maximum": 24,
          "order": 18,
          "scope": "application",
          "markdownDescription": "%neonGlow.snippetGlow.markdownDescription%"
        },
        "neonGlow.renameGlow": {
          "type": "number",
          "default": 12,
          "minimum": 0,
          "maximum": 32,
          "order": 19,
          "scope": "application",
          "markdownDescription": "%neonGlow.renameGlow.markdownDescription%"
        },
        "neonGlow.breathe": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 6000,
          "order": 20,
          "scope": "application",
          "markdownDescription": "%neonGlow.breathe.markdownDescription%"
        },
        "neonGlow.caretArc": {
          "type": "string",
          "default": "off",
          "enum": ["off", "arc", "beam", "comet", "flash", "wave", "bolt", "dots", "coil", "square", "zip", "pulse", "ring"],
          "enumDescriptions": [
            "%neonGlow.caretArc.enum.off%",
            "%neonGlow.caretArc.enum.arc%",
            "%neonGlow.caretArc.enum.beam%",
            "%neonGlow.caretArc.enum.comet%",
            "%neonGlow.caretArc.enum.flash%",
            "%neonGlow.caretArc.enum.wave%",
            "%neonGlow.caretArc.enum.bolt%",
            "%neonGlow.caretArc.enum.dots%",
            "%neonGlow.caretArc.enum.coil%",
            "%neonGlow.caretArc.enum.square%",
            "%neonGlow.caretArc.enum.zip%",
            "%neonGlow.caretArc.enum.pulse%",
            "%neonGlow.caretArc.enum.ring%"
          ],
          "order": 21,
          "scope": "application",
          "markdownDescription": "%neonGlow.caretArc.markdownDescription%"
        },
        "neonGlow.caretArcColor": {
          "type": "string",
          "default": "cursor",
          "pattern": "^(cursor|#([0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8}))$",
          "patternErrorMessage": "%neonGlow.caretArcColor.patternErrorMessage%",
          "anyOf": [{ "type": "string", "pattern": "^cursor$" }, { "type": "string", "format": "color-hex" }],
          "order": 22,
          "scope": "application",
          "markdownDescription": "%neonGlow.caretArcColor.markdownDescription%"
        },
        "neonGlow.caretArcMinJump": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 400,
          "order": 23,
          "scope": "application",
          "markdownDescription": "%neonGlow.caretArcMinJump.markdownDescription%"
        },
        "neonGlow.caretArcDuration": {
          "type": "number",
          "default": 300,
          "minimum": 80,
          "maximum": 1200,
          "order": 24,
          "scope": "application",
          "markdownDescription": "%neonGlow.caretArcDuration.markdownDescription%"
        },
        "neonGlow.caretArcOnDrag": {
          "type": "boolean",
          "default": false,
          "order": 25,
          "scope": "application",
          "markdownDescription": "%neonGlow.caretArcOnDrag.markdownDescription%"
        }
      }
    }
  }
}
