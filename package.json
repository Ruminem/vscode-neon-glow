{
  "name": "vscode-neon-glow",
  "displayName": "Neon Glow",
  "description": "Neon glow for syntax highlighting, derived from whatever colour theme is active.",
  "version": "0.4.2",
  "publisher": "Ruminem",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ruminem/vscode-neon-glow.git"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": ["Themes", "Other"],
  "icon": "icon.png",
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "scripts": {
    "package": "npx --yes @vscode/vsce package",
    "vscode:uninstall": "node ./uninstall.js"
  },
  "contributes": {
    "commands": [
      { "command": "neonGlow.toggle",  "title": "Neon Glow: Toggle" },
      { "command": "neonGlow.enable",  "title": "Neon Glow: Enable" },
      { "command": "neonGlow.disable", "title": "Neon Glow: Disable" },
      { "command": "neonGlow.install", "title": "Neon Glow: Patch the workbench bundle" },
      { "command": "neonGlow.remove",  "title": "Neon Glow: Restore the original bundle" },
      { "command": "neonGlow.status",  "title": "Neon Glow: Show status" }
    ],
    "menus": {
      "commandPalette": [
        { "command": "neonGlow.enable",  "when": "!neonGlow.enabled" },
        { "command": "neonGlow.disable", "when": "neonGlow.enabled" },
        { "command": "neonGlow.install", "when": "false" },
        { "command": "neonGlow.remove",  "when": "false" }
      ]
    }
  }
}
